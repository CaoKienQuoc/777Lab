# Copy file này thành .env rồi điền giá trị thật:  cp .env.example .env

# Mật khẩu tài khoản 'sa' của SQL Server.
# YÊU CẦU: >= 8 ký tự, có chữ HOA + chữ thường + số + ký tự đặc biệt.
SA_PASSWORD=Lab777_Timesheet_2026X

# --- Email thông báo blog (Gmail SMTP) ---
# Đặt EMAIL_ENABLED=true để bật gửi mail.
# SMTP_PASSWORD là "App Password" 16 ký tự của Gmail (Google Account >
# Security > bật 2-Step Verification > App passwords), gõ liền không dấu cách.
EMAIL_ENABLED=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=
